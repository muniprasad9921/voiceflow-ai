# VoiceFlow AI Environment Configuration Example
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit .env.local or any credentials to Git!

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Voice Engine & Telephony (Retell AI / Twilio)
RETELL_AI_API_KEY=your-retell-ai-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Messaging (WhatsApp Cloud API)
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# AI Chat Support & Knowledge RAG (Optional: falls back to built-in verified RAG engine if unset)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
